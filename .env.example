# Copy to .env and replace the placeholders. start.sh refuses to run without .env.
# Never commit .env. ensure-postgres.sh appends a random DATABASE_URL if one is missing.

LITELLM_MASTER_KEY=sk-local-change-me
ADAPTER_API_KEY=sk-adapter-change-me
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=4010
ADAPTER_PUBLIC_BASE=http://127.0.0.1:4010
LITELLM_PORT=4000

# Optional. ensure-postgres.sh creates these on first run if DATABASE_URL is absent.
# POSTGRES_PORT=55432
# DATABASE_URL=postgresql://litellm:change-me@127.0.0.1:55432/litellm
# LITELLM_PRISMA_COMMAND_TIMEOUT=300
# LITELLM_PRISMA_MIGRATE_DEPLOY_TIMEOUT=600
